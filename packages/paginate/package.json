{
  "name": "@evensurface/paginate",
  "version": "1.2.0",
  "description": "Type-safe, framework-independent offset pagination for TypeScript, Node.js, APIs, databases, and any ORM.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --clean --format esm,cjs --target es2022 --tsconfig tsconfig.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "check:fix": "biome check --write .",
    "dev": "tsdown src/index.ts --dts --watch --format esm,cjs --target es2022 --tsconfig tsconfig.json",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run publish:check",
    "publish:check": "pnpm run check && pnpm pack --dry-run",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "paginate",
    "paginator",
    "pagination",
    "offset-pagination",
    "page-number-pagination",
    "api-pagination",
    "database-pagination",
    "pagination-library",
    "typescript",
    "javascript",
    "nodejs",
    "database",
    "orm",
    "orm-agnostic"
  ],
  "author": {
    "name": "Shivam Gupta",
    "url": "https://github.com/shivamrun"
  },
  "homepage": "https://github.com/evensurface/paginate/tree/main/packages/paginate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evensurface/paginate.git",
    "directory": "packages/paginate"
  },
  "bugs": {
    "url": "https://github.com/evensurface/paginate/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "type": "module",
  "devDependencies": {
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
