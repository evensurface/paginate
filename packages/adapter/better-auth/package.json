{
  "name": "@evensurface/paginate-better-auth",
  "version": "1.0.1",
  "description": "Page and offset pagination for Better Auth database adapters.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --clean --format esm,cjs --target es2022 --tsconfig tsconfig.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "check:fix": "biome check --write .",
    "dev": "tsdown src/index.ts --dts --watch --format esm,cjs --target es2022 --tsconfig tsconfig.json",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run publish:check",
    "publish:check": "pnpm run check && pnpm pack --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "better-auth",
    "pagination",
    "offset-pagination",
    "typescript",
    "database"
  ],
  "author": {
    "name": "Shivam Gupta",
    "url": "https://github.com/shivamrun"
  },
  "homepage": "https://github.com/evensurface/paginate/tree/main/packages/adapter/better-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evensurface/paginate.git",
    "directory": "packages/adapter/better-auth"
  },
  "bugs": {
    "url": "https://github.com/evensurface/paginate/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "dependencies": {
    "@evensurface/paginate": "workspace:^"
  },
  "peerDependencies": {
    "better-auth": ">=1.7.0 <1.8.0"
  },
  "devDependencies": {
    "@better-auth/memory-adapter": "1.7.18",
    "@types/better-sqlite3": "^7.6.13",
    "better-auth": "1.7.18",
    "better-sqlite3": "^12.11.1",
    "tsdown": "^0.22.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
