{
  "name": "@seashq/pager-drizzle",
  "version": "1.0.0",
  "description": "Drizzle ORM adapter for @seashq/pager.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --clean --format esm,cjs --target es2022 --tsconfig tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsdown src/index.ts --dts --watch --format esm,cjs --target es2022 --tsconfig tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "pagination",
    "drizzle",
    "drizzle-orm",
    "typescript"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "type": "module",
  "dependencies": {
    "@seashq/pager": "workspace:^"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.4 <1"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4",
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
