{
  "name": "evensurface-paginate",
  "version": "1.0.0",
  "description": "A framework-independent, ORM-agnostic offset pagination package.",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "pack": "pnpm --filter @evensurface/paginate pack --pack-destination .artifacts",
    "release": "pnpm build && changeset publish",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version"
  },
  "keywords": [
    "pagination",
    "offset-pagination",
    "typescript"
  ],
  "author": "Evensurface",
  "homepage": "https://evensurface.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evensurface/paginate.git"
  },
  "bugs": {
    "url": "https://github.com/evensurface/paginate/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.10.5"
  }
}
