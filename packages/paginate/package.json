{
  "name": "@evensurface/paginate",
  "version": "1.0.0",
  "description": "Framework-independent, ORM-agnostic offset pagination for TypeScript.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --clean --format esm,cjs --target es2022 --tsconfig tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsdown src/index.ts --dts --watch --format esm,cjs --target es2022 --tsconfig tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "pagination",
    "offset-pagination",
    "typescript",
    "orm-agnostic"
  ],
  "author": "Evensurface",
  "homepage": "https://evensurface.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evensurface/paginate.git",
    "directory": "packages/paginate"
  },
  "bugs": {
    "url": "https://github.com/evensurface/paginate/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "type": "module",
  "devDependencies": {
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
